{
  "meta": { "id": "policy_single_agent_v1", "name": "Policy (Single Agent)", "version": "1.0.0" },
  "entryId": "n_entry",
  "schemas": {
    "Synthesis@1": {
      "type": "object",
      "required": ["answer","citations"],
      "properties": {
        "answer": { "type": "string" },
        "citations": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "confidence": { "type": "number" }
      }
    }
  },
  "nodes": [
    { "id": "n_entry", "kind": "entry.chat_form", "label": "Entry: Chat" },
    { "id": "n_agent", "kind": "agent.codeless", "label": "Policy Agent",
      "data": {
        "systemInstructions": "Answer user policy questions. Use policy.search when helpful. Cite sources.",
        "model": { "provider": "openai", "modelId": "gpt-4o-mini", "temperature": 0 },
        "tools": { "policy": "Auto", "attached": ["policy.search"] },
        "structuredOutput": { "enabled": true, "schemaRef": "#/schemas/Synthesis@1" }
      }
    },
    { "id": "n_out", "kind": "output", "label": "Output", "data": { "schemaRef": "#/schemas/Synthesis@1" } }
  ],
  "edges": [
    { "id": "e1", "from": "n_entry", "to": "n_agent",
      "mapping": [ { "from": "$.messages", "to": "messages" } ] },
    { "id": "e2", "from": "n_agent", "to": "n_out",
      "mapping": [ { "from": "$", "to": "$" } ] }
  ]
}
