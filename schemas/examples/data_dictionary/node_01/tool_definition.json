{
  id: "tool:sql_get_catalog_objects",
  name: "Get Catalog Objects",
  version: "1.0.0",
  category: "SQL Server",
  auth: { type: "ConnectionString" },
  parameters: [
    {
      name: "connection_string",
      type: "string",
      scope: "AgentOverride",
      description: "SQL Server connection string to the database."
    },
    {
      name: "include_schemas",
      type: "string",
      default: "",
      scope: "AgentOverride",
      description: "If non-empty, only include objects whose schema is in this comma-separated list."
    },
    {
      name: "include_tables",
      type: "boolean",
      default: true,
      scope: "AgentOverride",
      description: "Include tables in the retrieved objects."
    },
    {
      name: "include_views",
      type: "boolean",
      default: true,
      scope: "AgentOverride",
      description: "Include views in the retrieved objects."
    }
  ],
  status: "active",
  description: "List SQL Server catalog objects (tables/views) with optional schema/type filters."
}
