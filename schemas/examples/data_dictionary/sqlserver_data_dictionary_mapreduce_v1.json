  "defaults": {
    "toolTimeoutMs": 60000,
    "maxParallelism": 8,
    "historyPolicy": {
      "window": {
        "strategy": "token_budget",
        "budgetTokens": 4096
      },
      "include": {
        "roles": [
          "system",
          "user",
          "assistant"
        ],
        "toolCalls": {
          "previousTurns": false,
          "currentTurn": true,
          "mode": "summary"
        },
        "interAgent": {
          "previousTurns": false,
          "currentTurn": false,
          "channels": [
            "*"
          ]
        },
        "attachments": "references"
      },
      "summarize": {
        "enabled": true,
        "targetTokens": 800
      },
      "redact": {
        "pii": true,
        "secrets": true
      }
    }
