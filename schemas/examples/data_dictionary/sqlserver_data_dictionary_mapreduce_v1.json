  "nodes": [
    {
      "id": "n_entry",
      "kind": "entry.chat_form",
      "label": "Entry: Parameters",
      "data": {
        "formSchemaRef": "#/schemas/Form@1"
      }
    },
    {
      "id": "n_get_catalog",
      "kind": "tool",
      "label": "db.get_catalog_objects",
      "data": {
        "toolId": "db.get_catalog_objects",
        "argsSchema": {
          "type": "object",
          "properties": {
            "schema_like": {
              "type": "string"
            },
            "include_views": {
              "type": "boolean"
            },
            "max_objects": {
              "type": "integer"
            }
          },
          "required": [
            "schema_like",
            "include_views",
            "max_objects"
          ]
        }
      }
    },
    {
      "id": "n_parallel_objects",
      "kind": "parallel",
      "label": "Map: Objects",
      "data": {
        "mode": "items",
        "concurrency": 6,
        "timeoutSec": 600,
        "extensions": {
          "iteration": {
            "itemVar": "variables.current_object",
            "indexVar": "variables.current_object_index"
          }
        }
      }
    },
    {
      "id": "n_get_meta",
      "kind": "tool",
      "label": "db.get_object_metadata",
      "data": {
        "toolId": "db.get_object_metadata"
      }
    },
    {
      "id": "n_profile_table",
      "kind": "tool",
      "label": "db.profile_table",
      "data": {
        "toolId": "db.profile_table"
      }
    },
    {
      "id": "n_parallel_columns",
      "kind": "parallel",
      "label": "Map: Columns",
      "data": {
        "mode": "items",
        "concurrency": 8,
        "timeoutSec": 900,
        "extensions": {
          "iteration": {
            "itemVar": "variables.current_column",
            "indexVar": "variables.current_column_index"
          }
        }
      }
    },
    {
      "id": "n_profile_column",
      "kind": "tool",
      "label": "db.profile_column",
      "data": {
        "toolId": "db.profile_column"
      }
    },
    {
      "id": "n_reduce_columns",
      "kind": "reducer",
      "label": "Reduce: Column Profiles",
      "data": {
        "fields": [
          {
            "target": "column_profiles",
            "strategy": "list_concat"
          }
        ]
      }
    },
    {
      "id": "n_annotate_object",
      "kind": "agent.codeless",
      "label": "Annotate Object (LLM)",
      "data": {
        "systemInstructions": "You write a high-quality data dictionary entry for ONE DB object.\nUse provided metadata + table profile + column profiles as evidence.\nRules:\n- Label claims as Confirmed (from metadata/profiles) or Hypothesis (naming inference).\n- Provide concise table_description and grain.\n- For each column: description + pii_risk. If low-cardinality, propose enum_mapping from top_values.\n- Emit inferred_join_candidates only when you have evidence (naming + key-like stats).\n",
        "model": {
          "provider": "openai",
          "modelId": "gpt-4o-mini",
          "temperature": 0
        },
        "tools": {
          "policy": "Disabled",
          "attached": []
        },
        "structuredOutput": {
          "enabled": true,
          "schemaRef": "#/schemas/ObjectDoc"
        }
      }
    },
    {
      "id": "n_extract_join_candidates",
      "kind": "agent.codeless",
      "label": "Extract Join Candidates",
      "data": {
        "systemInstructions": "From the ObjectDoc you produced, return ONLY JoinCandidateArray.\nInclude declared_fk items too if present in declared_relationships.\nIf none, return an empty array.",
        "model": {
          "provider": "openai",
          "modelId": "gpt-4o-mini",
          "temperature": 0
        },
        "tools": {
          "policy": "Disabled",
          "attached": []
        },
        "structuredOutput": {
          "enabled": true,
          "schemaRef": "#/schemas/JoinCandidateArray"
        }
      }
    },
    {
      "id": "n_parallel_join_verify",
      "kind": "parallel",
      "label": "Map: Verify Joins",
      "data": {
        "mode": "items",
        "concurrency": 6,
        "timeoutSec": 900
      }
    },
    {
      "id": "n_verify_join",
      "kind": "tool",
      "label": "db.verify_join",
      "data": {
        "toolId": "db.verify_join"
      }
    },
    {
      "id": "n_reduce_joins",
      "kind": "reducer",
      "label": "Reduce: Join Verifications",
      "data": {
        "fields": [
          {
            "target": "join_verifications",
            "strategy": "list_concat"
          }
        ]
      }
    },
    {
      "id": "n_reduce_objects",
      "kind": "reducer",
      "label": "Reduce: Object Docs",
      "data": {
        "fields": [
          {
            "target": "objects",
            "strategy": "list_concat"
          },
          {
            "target": "join_verifications",
            "strategy": "list_concat"
          },
          {
            "target": "issues",
            "strategy": "list_concat"
          }
        ]
      }
    },
    {
      "id": "n_qa",
      "kind": "agent.codeless",
      "label": "QA & Consistency Pass",
      "data": {
        "systemInstructions": "You are a QA agent for a generated data dictionary.\nInput includes objects, join_verifications.\nFind inconsistencies (enum claims vs distinct counts, low join match_rate, suspicious PII tags, etc.)\nReturn IssueArray.",
        "model": {
          "provider": "openai",
          "modelId": "gpt-4o-mini",
          "temperature": 0
        },
        "tools": {
          "policy": "Disabled",
          "attached": []
        },
        "structuredOutput": {
          "enabled": true,
          "schemaRef": "#/schemas/IssueArray"
        }
      }
    },
    {
      "id": "n_render",
      "kind": "agent.codeless",
      "label": "Render Outputs",
      "data": {
        "systemInstructions": "Render the final DataDictionaryResult@1.\nIf emit_markdown is true, create markdown (tables per object).\nIf emit_json is true, include a json object that mirrors the data.\nAlways include objects, join_verifications, issues.\n",
        "model": {
          "provider": "openai",
          "modelId": "gpt-4o-mini",
          "temperature": 0
        },
        "tools": {
          "policy": "Disabled",
          "attached": []
        },
        "structuredOutput": {
          "enabled": true,
          "schemaRef": "#/schemas/DataDictionaryResult@1"
        }
      }
    },
    {
      "id": "n_out",
      "kind": "output",
      "label": "Output",
      "data": {
        "schemaRef": "#/schemas/DataDictionaryResult@1"
      }
    }
  ],
